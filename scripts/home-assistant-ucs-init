#!/bin/sh
set -eu

install -d -m 0755 /opt/home-assistant-ucs /var/lib/home-assistant-ucs
install -d -m 0755 /var/lib/home-assistant-ucs/config /etc/home-assistant-ucs

local_file=/etc/home-assistant-ucs/configuration.local.yaml
config_file=/var/lib/home-assistant-ucs/config/configuration.yaml

# migrate existing unmanaged configuration once before switching to generated config
if [ -s "$config_file" ] && ! grep -q '^# generated by home-assistant-ucs-merge-config' "$config_file"; then
    if [ ! -s "$local_file" ] || ! grep -Eq '^[^#[:space:]]' "$local_file" || \
        [ "$(sed '/^#/d; /^$/d' "$local_file" | tr -d '[:space:]')" = '{}' ]; then
        cp "$config_file" "$local_file"
        chmod 0644 "$local_file"
    else
        echo 'home-assistant-ucs-init: existing config and local override both present; refusing overwrite' >&2
        exit 1
    fi
fi

/usr/lib/home-assistant-on-ucs/home-assistant-ucs-merge-config
