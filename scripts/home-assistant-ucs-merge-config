#!/usr/bin/python3
"""Merge UCR Home Assistant defaults with persistent local YAML configuration."""

import argparse
import os
import tempfile
from pathlib import Path

import yaml


class TaggedValue:
    def __init__(self, tag, value):
        self.tag = tag
        self.value = value


class HomeAssistantLoader(yaml.SafeLoader):
    pass


class HomeAssistantDumper(yaml.SafeDumper):
    pass


def load_ha_tag(loader, suffix, node):
    if isinstance(node, yaml.ScalarNode):
        value = loader.construct_scalar(node)
    elif isinstance(node, yaml.SequenceNode):
        value = loader.construct_sequence(node, deep=True)
    else:
        value = loader.construct_mapping(node, deep=True)
    return TaggedValue('!' + suffix, value)


def dump_ha_tag(dumper, obj):
    if isinstance(obj.value, str):
        return dumper.represent_scalar(obj.tag, obj.value)
    if isinstance(obj.value, list):
        return dumper.represent_sequence(obj.tag, obj.value)
    return dumper.represent_mapping(obj.tag, obj.value)


HomeAssistantLoader.add_multi_constructor('!', load_ha_tag)
HomeAssistantDumper.add_representer(TaggedValue, dump_ha_tag)


def deep_merge(defaults, local):
    if isinstance(defaults, dict) and isinstance(local, dict):
        result = dict(defaults)
        for key, value in local.items():
            result[key] = deep_merge(result[key], value) if key in result else value
        return result
    return local


def read_mapping(path):
    if not path.exists():
        return {}
    data = yaml.load(path.read_text(encoding='utf-8'), Loader=HomeAssistantLoader)  # noqa: S506
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise ValueError(f'{path} must contain a YAML mapping at the top level')
    return data


def merge_files(defaults, local, output):
    config = deep_merge(read_mapping(defaults), read_mapping(local))
    rendered = '# generated by home-assistant-ucs-merge-config; edit configuration.local.yaml\n'
    rendered += yaml.dump(config, Dumper=HomeAssistantDumper, allow_unicode=True, sort_keys=False, default_flow_style=False)

    output.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if output.exists() and output.read_text(encoding='utf-8') == rendered:
        return False

    fd, tmp = tempfile.mkstemp(prefix='.configuration.yaml.', dir=output.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, output)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--defaults', type=Path, default=Path('/etc/home-assistant-ucs/configuration.default.yaml'))
    parser.add_argument('--local', type=Path, default=Path('/etc/home-assistant-ucs/configuration.local.yaml'))
    parser.add_argument('--output', type=Path, default=Path('/var/lib/home-assistant-ucs/config/configuration.yaml'))
    args = parser.parse_args()
    merge_files(args.defaults, args.local, args.output)


if __name__ == '__main__':
    main()
