#!/bin/sh
## joinscript api: bindpwdfile

VERSION=1
. /usr/share/univention-join/joinscripthelper.lib
joinscript_init

eval "$(ucr shell)"
name="${homeassistant_domain:-homeassistant.$domainname}"

# create groups without adding any LDAP users automatically
udm groups/group create "$@" --ignore_exists \
    --position "cn=groups,$ldap_base" --set name=homeassistant-users \
    --set description='Users allowed to log in to Home Assistant' || die
udm groups/group create "$@" --ignore_exists \
    --position "cn=groups,$ldap_base" --set name=homeassistant-admins \
    --set description='Home Assistant administrators' || die

# create a single-label CNAME inside the local UCS DNS zone
case "$name" in
    *."$domainname") label=${name%."$domainname"} ;;
    *) echo 'Home Assistant name must be in the UCS DNS zone' >&2; exit 1 ;;
esac
case "$label" in
    *.*|'') echo 'DNS alias must consist of one label' >&2; exit 1 ;;
esac
zone="zoneName=$domainname,cn=dns,$ldap_base"
if udm dns/forward_zone list "$@" --filter "zone=$domainname" | grep -Fq "DN: $zone"; then
    udm dns/alias create "$@" --ignore_exists --superordinate "$zone" \
        --set name="$label" --set cname="$hostname.$domainname." || die
else
    echo 'DNS zone not found; skipping CNAME' >&2
fi

# the default web port is loopback-only and needs no inbound firewall rule
# allow optional direct access only after explicit configuration
if [ "$(ucr get homeassistant/firewall/direct-access)" = yes ]; then
    port=$(ucr get homeassistant/http-port)
    case "$port" in ''|*[!0-9]*) die 'Invalid Home Assistant host port' ;; esac
    ucr set "security/packetfilter/package/home-assistant-on-ucs/tcp/$port/all=ACCEPT" \
        "security/packetfilter/package/home-assistant-on-ucs/tcp/$port/all/en=Home Assistant direct HTTP"
    systemctl restart univention-firewall.service || true
fi

/usr/lib/home-assistant-on-ucs/home-assistant-ucs-init
systemctl start home-assistant-ucs.service || die

# register a Home Assistant portal tile
icon=/usr/share/home-assistant-on-ucs/home-assistant.svg
portal_base="cn=portals,cn=univention,$ldap_base"
entry_dn="cn=home-assistant,cn=entry,$portal_base"
category_dn="cn=domain-service,cn=category,$portal_base"
udm portals/entry create "$@" --ignore_exists \
    --position "cn=entry,$portal_base" \
    --set name=home-assistant \
    --append displayName='"de_DE" "Home Assistant"' \
    --append displayName='"en_US" "Home Assistant"' \
    --append description='"de_DE" "Hausautomation"' \
    --append description='"en_US" "Home automation"' \
    --append link="\"de_DE\" \"https://$name/\"" \
    --append link="\"en_US\" \"https://$name/\"" \
    --set activated=TRUE --set anonymous=FALSE --set linkTarget=newwindow \
    --set icon="$(base64 -w0 "$icon")" || die
udm portals/category modify "$@" --ignore_not_exists \
    --dn "$category_dn" --append entries="$entry_dn" || die

joinscript_save_current_version
exit 0
